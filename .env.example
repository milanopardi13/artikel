# Rosie Atelier — environment variables (copy to .env.local for dev; set in Netlify/Vercel UI for prod)

# ── Admin panel (REQUIRED in production) ────────────────────────────────
# Without these two, /api/auth/login returns 401 "admin_not_configured" in production.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# HMAC key for the session cookie. Any long random string, e.g. `openssl rand -hex 32`.
# If unset, ADMIN_PASSWORD is used as the signing key — set a dedicated one.
AUTH_SECRET=

# ── Content persistence (REQUIRED on Netlify/Vercel for admin saves) ────
# Serverless filesystems are read-only: without one of the backends below, the admin
# "Save" fails (502 storage_write_failed) and edits never persist across deploys.
# Option 1 (recommended): Upstash Redis — free tier is enough.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Option 2: Vercel Blob (only practical when deploying on Vercel).
BLOB_READ_WRITE_TOKEN=
# With neither, content falls back to ./data/content.json (local dev / VPS / Docker only).

# ── Canonical site URL (used by sitemap.xml, robots.txt and OG metadata) ─
# Set this to your production URL WITHOUT a trailing slash, e.g. https://your-site.netlify.app
NEXT_PUBLIC_SITE_URL=
